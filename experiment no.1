
#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100], sub[100];
    int choice, i, start, len, n, flag = 1;

    printf("Enter a string: ");
    scanf("%99s", str1);

    printf("\n1. Substring");
    printf("\n2. Palindrome");
    printf("\n3. Compare");
    printf("\n4. Copy");
    printf("\n5. Reverse");
    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    switch(choice)
    {
        case 1:
            printf("Enter starting position and length: ");
            scanf("%d%d", &start, &len);

            n = strlen(str1);

            if(start < 0 || start >= n || len < 0)
            {
                printf("Invalid position or length");
                break;
            }

            for(i = 0; i < len && start + i < n; i++)
                sub[i] = str1[start + i];

            sub[i] = '\0';
            printf("Substring = %s", sub);
            break;

        case 2:
            n = strlen(str1);

            for(i = 0; i < n / 2; i++)
            {
                if(str1[i] != str1[n - i - 1])
                {
                    flag = 0;
                    break;
                }
            }

            if(flag)
                printf("Palindrome");
            else
                printf("Not a palindrome");
            break;

        case 3:
            printf("Enter another string: ");
            scanf("%99s", str2);

            if(strcmp(str1, str2) == 0)
                printf("Strings are equal");
            else
                printf("Strings are not equal");
            break;

        case 4:
            strcpy(str2, str1);
            printf("Copied string = %s", str2);
            break;

        case 5:
            n = strlen(str1);

            printf("Reversed string = ");
            for(i = n - 1; i >= 0; i--)
                printf("%c", str1[i]);
            break;

        default:
            printf("Invalid choice");
    }

    return 0;
}
